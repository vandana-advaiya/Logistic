<section class="vision-commitment-section py-5">
        <div class="row g-4">
            <div class="col-lg-5 ps-lg-5">
                <div class="vision-block">
                    <div class="vision-title-wrapper">
                        <h3 class="vision-title mb-0">Vision</h3>
                    </div>
                    <p class="vision-text mt-3 mb-0">
                        To be a world class leader in businesses that enrich lives and contribute
                        to nations in building infrastructure through sustainable value creation.
                    </p>
                </div>
            </div>
            <div class="col-lg-7 p-0">
                <div id="commitmentCarousel" class="carousel slide commitment-carousel" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        <!-- SLIDE 1 -->
                        <div class="carousel-item active">
                            <div class="commitment-slide">
                                <!-- BACKGROUND IMAGE -->
                                <img src="~/media/vision-bg.jpg"
                                     alt="Team Image"
                                     class="slide-bg-img">
                                <!-- Dark Overlay -->
                                <div class="commitment-overlay"></div>
                                <!-- Text Content -->
                                <div class="commitment-content">
                                    <h3 class="commitment-heading">Commitment</h3>
                                    <p class="commitment-text">
                                        We shall stand by our promises and adhere to high standards of business.
                                    </p>
                                </div>

                                <!-- Slider Arrows -->
                                <div class="commitment-controls">
                                    <button class="ctrl-btn prev" data-bs-target="#commitmentCarousel" data-bs-slide="prev">
                                        <span class="ctrl-icon">&lt;</span>
                                    </button>
                                    <button class="ctrl-btn next" data-bs-target="#commitmentCarousel" data-bs-slide="next">
                                        <span class="ctrl-icon">&gt;</span>
                                    </button>
                                </div>

                            </div>
                        </div>
                        <!-- SLIDE 2 -->
                        <div class="carousel-item">
                            <div class="commitment-slide">

                                <!-- BACKGROUND IMAGE -->
                                <img src="~/media/vision-bg.jpg"
                                     alt="Team Image"
                                     class="slide-bg-img">

                                <!-- Dark Overlay -->
                                <div class="commitment-overlay"></div>

                                <!-- Text Content -->
                                <div class="commitment-content">
                                    <h3 class="commitment-heading">Commitment</h3>
                                    <p class="commitment-text">
                                        We shall stand by our promises and adhere to high standards of business.
                                    </p>
                                </div>

                                <!-- Slider Arrows -->
                                <div class="commitment-controls">
                                    <button class="ctrl-btn prev" data-bs-target="#commitmentCarousel" data-bs-slide="prev">
                                        <span class="ctrl-icon">&lt;</span>
                                    </button>
                                    <button class="ctrl-btn next" data-bs-target="#commitmentCarousel" data-bs-slide="next">
                                        <span class="ctrl-icon">&gt;</span>
                                    </button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
</section>
