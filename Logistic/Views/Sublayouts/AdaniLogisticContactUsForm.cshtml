<section class="collab-section py-5">
    <div class="container">

        <h3 class="collab-title text-center mb-4">Let's collaborate</h3>

        <div class="collab-form-wrapper">

            <form>

                <div class="row g-4">

                    <!-- Full Name -->
                    <div class="col-md-6">
                        <label class="form-label">Full Name *</label>
                        <input type="text" class="form-control" placeholder="John Doe">
                    </div>

                    <!-- Email -->
                    <div class="col-md-6">
                        <label class="form-label">Email *</label>
                        <input type="email" class="form-control" placeholder="john@company.com">
                    </div>

                    <!-- Phone Number -->
                    <div class="col-md-6">
                        <label class="form-label">Phone Number</label>
                        <input type="text" class="form-control" placeholder="+1 (555) 123-4567">
                    </div>

                    <!-- Company Name -->
                    <div class="col-md-6">
                        <label class="form-label">Company Name</label>
                        <input type="text" class="form-control" placeholder="ACME Corp">
                    </div>

                    <!-- Space Required -->
                    <div class="col-md-6">
                        <label class="form-label">Space Required</label>

                        <div class="space-wrapper d-flex align-items-center gap-2">
                            <input type="text" class="form-control" placeholder="Select Space Size">

                            <div class="unit-option d-flex align-items-center gap-2">
                                <label><input type="radio" name="unit" checked> Sq.Ft.</label>
                                <label><input type="radio" name="unit"> Sq.Mt.</label>
                            </div>
                        </div>
                    </div>

                    <!-- Agreement Term -->
                    <div class="col-md-6">
                        <label class="form-label">Agreement Term (Years)</label>
                        <select class="form-select">
                            <option>Select Duration</option>
                            <option>1 Year</option>
                            <option>3 Years</option>
                            <option>5 Years</option>
                        </select>
                    </div>

                    <!-- Warehouse Location -->
                    <div class="col-md-6">
                        <label class="form-label">Select Warehouse Location*</label>
                        <select class="form-select">
                            <option>Select Warehouse Location</option>
                        </select>
                    </div>

                    <!-- Category -->
                    <div class="col-md-6">
                        <label class="form-label">Category*</label>
                        <select class="form-select">
                            <option>Select Warehouse Category</option>
                        </select>
                    </div>

                    <!-- Additional Requirements -->
                    <div class="col-12">
                        <label class="form-label">Additional Requirements</label>
                        <textarea class="form-control" rows="3" placeholder="Tell us about any special requirements..."></textarea>
                    </div>

                    <!-- Submit Button -->
                    <div class="col-12 text-center mt-2">
                        <button type="submit" class="collab-btn">
                            Submit →
                        </button>
                    </div>

                </div>

            </form>
        </div>

    </div>
</section>
