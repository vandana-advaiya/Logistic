<section class="our-solutions-section py-5">
    <div class="container text-center">

        <h3 class="section-title">Our Solutions</h3>
        <p class="section-desc">
            We are a leading provider of integrated warehousing and logistics solutions, offering safe, efficient,
            and technology-enabled storage services across India.
        </p>
        <!-- Toggle -->
        <div class="solutions-toggle">
            <button class="toggle-btn active"
                    data-solution="Ready-to-move"
                    data-bubble1="Prime Positioning"
                    data-bubble2="Proactive facility management"
                    data-bubble3="Optimized design & layout"            
                    data-bubble4="Tailored enhancement">
                Ready-to-move
            </button>

            <button class="toggle-btn"
                    data-solution="Built-to-suit"
                    data-bubble1="Design Customization"
                    data-bubble2="Technology Integration"
                    data-bubble3="Advanced Infrastructure"
                    data-bubble4="Future-Ready Expansion">
                Built-to-suit
            </button>
        </div>

        <!-- Diagram -->
        <div class="solutions-diagram">
            <svg class="curve-right" viewBox="0 0 720 180" fill="none">
                <path d="M10 25 C300 200, 420 200, 710 25"
                      stroke="#CFCFCF"
                      stroke-width="2"
                      stroke-dasharray="6 8"
                      fill="none" />
            </svg>
            <h1 id="centerText" class="diagram-title"></h1>
            <div class="top-row">
                <div class="bubble bubble1 purple"></div>
                <div class="bubble bubble2 teal"></div>
            </div>
            <div class="bottom-row">
                <div class="bubble bubble3 pink"></div>
                <div class="bubble bubble4 blue"></div>
            </div>
        </div>
    </div>
</section>
