<section class="connectivity-section py-5">
    <div class="container">

        <!-- Heading -->
        <div class="text-center mb-4">
            <h2 class="connect-title">Maps and Connectivity details</h2>
            <p class="connect-subtitle">Explore our Warehouse</p>
        </div>

        <div class="row align-items-center justify-content-between">

            <!-- LEFT COLUMN -->
            <div class="col-lg-6">

                <div class="connect-block">
                    <p class="left-label">City landmarks</p>
                    <div class="right-grid">
                        <div class="connect-card">
                            <div class="icon-box icon-purple"><img src="~/media/City-landmarks.svg" alt=""></div>
                            <div>
                                <h4>32 Km</h4>
                                <p>Delhi Mumbai Expressway</p>
                            </div>
                        </div>

                        <div class="connect-card">
                            <div class="icon-box icon-purple"><img src="~/media/City-landmarks.svg" alt=""></div>
                            <div>
                                <h4>66 Km</h4>
                                <p>New Delhi Railway Station</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="connect-block">
                    <p class="left-label">Ports & ICDs</p>
                    <div class="right-grid">
                        <div class="connect-card">
                            <div class="icon-box icon-blue"><img src="~/media/City-landmarks.svg" alt=""></div>
                            <div>
                                <h4>50 Km</h4>
                                <p>Hind Terminals</p>
                            </div>
                        </div>

                        <div class="connect-card">
                            <div class="icon-box icon-blue"><img src="~/media/City-landmarks.svg" alt=""></div>
                            <div>
                                <h4>53 Km</h4>
                                <p>ATCL ICD</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="connect-block">
                    <p class="left-label">Industrial Areas</p>
                    <div class="right-grid">
                        <div class="connect-card">
                            <div class="icon-box icon-green"><img src="~/media/City-landmarks.svg" alt=""></div>
                            <div>
                                <h4>34 Km</h4>
                                <p>Ballabgarh Industrial Area</p>
                            </div>
                        </div>

                        <div class="connect-card">
                            <div class="icon-box icon-green"><img src="~/media/City-landmarks.svg" alt=""></div>
                            <div>
                                <h4>65 Km</h4>
                                <p>Faridabad Industrial Area</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- RIGHT SIDE MAP -->
            <div class="col-lg-5 text-center">
                <div class="map-wrapper">
                    <img src="/media/Warehouse-map.svg" alt="Haryana Map" class="map-img">
