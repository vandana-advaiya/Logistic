                </div>

                <div class="swiper-slide amenity-card">
                    <img src="/media/WideApron.svg" alt="">
                    <p>Wide Apron</p>
                </div>

                <div class="swiper-slide amenity-card">
                    <img src="/media/RidgeVentilation.svg" alt="">
                    <p>Ridge Ventilation<br>System</p>
                </div>

                <div class="swiper-slide amenity-card">
                    <img src="/media/OpenParking.svg" alt="">
                    <p>Open Parking</p>
                </div>

                <div class="swiper-slide amenity-card">
                    <img src="/media/StatutoryApproval.svg" alt="">
                    <p>Statutory Approval</p>
                </div>  <div class="swiper-slide amenity-card">
                    <img src="/media/StatutoryApproval.svg" alt="">
                    <p>Statutory Approval</p>
                </div>  <div class="swiper-slide amenity-card">
                    <img src="/media/StatutoryApproval.svg" alt="">
                    <p>Statutory Approval</p>
                </div>  <div class="swiper-slide amenity-card">
                    <img src="/media/StatutoryApproval.svg" alt="">
                    <p>Statutory Approval</p>
                </div>

            </div>

            <!-- Navigation Arrows -->
            <div class="swiper-button-prev custom-prev"></div>
            <div class="swiper-button-next custom-next"></div>
        </div>
        </div>
    </div>
</section>

