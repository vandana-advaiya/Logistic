            </div>
        </div>

        <!-- Amenities Card -->
        <div class="amenities-card">

            <h4 class="amenities-title">Amenities & features</h4>

        <!-- Swiper -->
        <div class="swiper amenitiesSwiper">

            <div class="swiper-wrapper">

                <div class="swiper-slide amenity-card">
                    <img src="/media/ClearHeight.svg" alt="">
