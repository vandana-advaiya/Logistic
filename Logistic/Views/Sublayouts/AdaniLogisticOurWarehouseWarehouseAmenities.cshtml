<section class="warehouse-info-section py-5">
    <div class="container">

        <!-- Top Heading -->
        <h3 class="top-heading text-center mb-3">World-class facilities and services for your business</h3>

        <!-- Stats Row -->
        <div class="warehouse-stats d-flex justify-content-center align-items-center gap-5 mb-4">
            <div class="stat-block">
                <p class="stat-label">Operational Area</p>
                <h2 class="stat-value">50,000 sq ft</h2>
            </div>

            <div class="divider"></div>

            <div class="stat-block">
                <p class="stat-label">Total Warehouse Area</p>
                <h2 class="stat-value">50,000 sq ft</h2>
            </div>

            <div class="divider"></div>

            <div class="stat-block">
                <p class="stat-label">Use Case</p>
